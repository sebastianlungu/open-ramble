{
  "name": "open-ramble",
  "version": "1.0.0",
  "type": "module",
  "description": "Zero-friction multimodal intent compiler for coding agents",
  "license": "MIT",
  "packageManager": "bun@1.3.11",
  "bin": {
    "open-ramble": "./src/index.ts"
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.18.9"
  },
  "scripts": {
    "open-ramble": "bun run src/index.ts",
    "test": "bun test",
    "lint": "bunx oxlint .",
    "lint:fix": "bunx oxlint --fix .",
    "typecheck": "bunx tsc --noEmit",
    "check": "bun run lint && bun run typecheck && bun run test",
    "proof": "bun run src/opencode-bridge/proof.ts",
    "proof:runtime": "bun test runtime-proof/tests/runtime-proof.test.ts",
    "proof:oauth": "bun run runtime-proof/tests/oauth-proof.ts",
    "proof:x64": "bash runtime-proof/tests/x86-verify.sh",
    "proof:compiler": "bash runtime-proof/tests/standalone-compiler-proof.sh",
    "start": "bun run src/index.ts",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "lefthook": "^2.1.10"
  }
}
